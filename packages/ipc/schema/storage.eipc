module jaquelene

subtype ByteCount = number(
  minValue: 0
  maxValue: 9007199254740991
)

enum StorageCategory {
  Content = "content"
  Cache = "cache"
  AppData = "app-data"
}

structure StorageAreaUsage {
  id: string
  category: StorageCategory
  bytes: ByteCount
}

structure StorageUsage {
  areas: StorageAreaUsage[]
}

structure StorageDeletion {
  areas: StorageAreaUsage[]
}

[RendererAPI]
[Validator=TrustedRenderer]
[ContextBridge]
interface Storage {
  measureUsage() -> StorageUsage
  deleteArea(id: string) -> StorageDeletion
  deleteCategory(id: StorageCategory) -> StorageDeletion
}
