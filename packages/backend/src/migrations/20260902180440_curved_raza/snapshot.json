    },
    {
      "value": "\"failure_kind\" IS NULL OR \"failure_kind\" IN ('preparation', 'provider', 'invalid-output', 'interrupted', 'storage')",
      "name": "generations_failure_kind_valid",
      "entityType": "checks",
      "table": "generations"
    },
    {
