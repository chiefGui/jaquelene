module jaquelene

subtype ScenarioTitle = string(
  minLength: 1
  maxLength: 240
)

structure Scenario {
  id: string
  title: ScenarioTitle
}

structure CreateScenarioRequest {
  title: ScenarioTitle
}

structure RenameScenarioRequest {
  id: string
  title: ScenarioTitle
}

[RendererAPI]
[Validator=TrustedRenderer]
[ContextBridge]
interface Scenarios {
  create(request: CreateScenarioRequest) -> Scenario
  list() -> Scenario[]
  get(id: string) -> Scenario?
  rename(request: RenameScenarioRequest) -> Scenario?
}
