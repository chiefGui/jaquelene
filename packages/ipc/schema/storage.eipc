module jaquelene

subtype ByteCount = number(
  minValue: 0
  maxValue: 9007199254740991
)

enum StorageCategory {
  Content = "content"
  AppData = "app-data"
}

structure StorageCategoryUsage {
  id: StorageCategory
  bytes: ByteCount
}

structure StorageUsage {
  categories: StorageCategoryUsage[]
}

[RendererAPI]
[Validator=TrustedRenderer]
[ContextBridge]
interface Storage {
  measureUsage() -> StorageUsage
  deleteCategory(id: StorageCategory) -> StorageUsage
}
