{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": "./dist/contracts",
    "rootDir": "./src",
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.contracts.tsbuildinfo",
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
