module jaquelene

subtype ThreadMessageContent = string(
  minLength: 1
  maxLength: 100000
)

subtype ThreadMessageCursor = string(
  minLength: 1
  maxLength: 64
)

subtype ThreadMessageSequence = number(
  minValue: 1
  maxValue: 9007199254740991
)

subtype ThreadMessageCountLimit = number(
  minValue: 1
  maxValue: 9007199254740991
)

subtype ThreadMessageMaxCodeUnits = number(
  minValue: 1
  maxValue: 9007199254740991
)

subtype ThreadMessageContentByteCount = number(
  minValue: 0
  maxValue: 9007199254740991
)

subtype ThreadMessageContentByteBudget = number(
  minValue: 1
  maxValue: 9007199254740991
)

subtype ThreadDeletedTurnCount = number(
  minValue: 1
  maxValue: 9007199254740991
)

enum ThreadMessageAuthor {
  User = "user"
  Assistant = "assistant"
}

enum ThreadMessagePageDirection {
  Older = "older"
  Newer = "newer"
}

enum GenerationStatus {
  Pending = "pending"
  Completed = "completed"
  Failed = "failed"
}

enum GenerationIntent {
  Reply = "reply"
  Retry = "retry"
  Regeneration = "regeneration"
}

enum GenerationFailureKind {
  Preparation = "preparation"
  Provider = "provider"
  InvalidOutput = "invalid-output"
  Interrupted = "interrupted"
  Storage = "storage"
}

structure ThreadMessage {
  id: string
  threadId: string
  turnId: string
  sequence: ThreadMessageSequence
  author: ThreadMessageAuthor
  content: ThreadMessageContent
  createdAt: UnixTimeMilliseconds
}

structure TurnGeneration {
  id: string
  turnId: string
  providerId: string
  modelId: string
  reasoning?: ResolvedReasoning
  intent: GenerationIntent
  status: GenerationStatus
  failureKind?: GenerationFailureKind
  outputMessageId?: string
  startedAt: UnixTimeMilliseconds
  finishedAt?: UnixTimeMilliseconds
}

structure ThreadMessagePageRequest {
  threadId: string
  direction: ThreadMessagePageDirection
  cursor?: ThreadMessageCursor
}

structure ThreadMessagePage {
  messages: ThreadMessage[]
  generations: TurnGeneration[]
  messageCountLimit: ThreadMessageCountLimit
  messageMaxCodeUnits: ThreadMessageMaxCodeUnits
  contentByteBudget: ThreadMessageContentByteBudget
  contentBytes: ThreadMessageContentByteCount
  olderCursor?: ThreadMessageCursor
  newerCursor?: ThreadMessageCursor
}

structure SubmitTurnRequest {
  threadId: string
  content: ThreadMessageContent
  configuration: GenerationConfiguration
}

structure RetryTurnRequest {
  turnId: string
  configuration: GenerationConfiguration
}

structure RegenerateReplyRequest {
  assistantMessageId: string
  configuration: GenerationConfiguration
}

structure DeleteThreadHistoryRequest {
  threadId: string
  userMessageId: string
}

structure ThreadHistoryDeletion {
  threadId: string
  userMessageId: string
  activeMessageId?: string
  deletedTurnCount: ThreadDeletedTurnCount
}

structure TurnSubmission {
  userMessage: ThreadMessage
  generation: TurnGeneration
}

structure FailedReply {
  userMessage: ThreadMessage
  generation: TurnGeneration
}

structure CompletedReply {
  userMessage: ThreadMessage
  assistantMessage: ThreadMessage
  generation: TurnGeneration
}

structure SupersededReply {
  threadId: string
}

[RendererAPI]
[Validator=TrustedRenderer]
[ContextBridge]
interface Threads {
  listMessages(request: ThreadMessagePageRequest) -> ThreadMessagePage
}

[RendererAPI]
[Validator=TrustedRenderer]
[ContextBridge]
interface Turns {
  submit(request: SubmitTurnRequest) -> TurnSubmission
  retry(request: RetryTurnRequest) -> TurnGeneration
  regenerate(request: RegenerateReplyRequest) -> TurnGeneration
  deleteFrom(request: DeleteThreadHistoryRequest) -> ThreadHistoryDeletion

  [Event]
  historyDeleted(deletion: ThreadHistoryDeletion)

  [Event]
  replyFailed(failure: FailedReply)

  [Event]
  replyCompleted(completion: CompletedReply)

  [Event]
  replySuperseded(reply: SupersededReply)
}
