module jaquelene

subtype UnixTimeMilliseconds = number(
  minValue: 0
  maxValue: 9007199254740991
)

structure Campaign {
  id: string
  scenarioId: string
  startedAt: UnixTimeMilliseconds
}

structure CampaignModelPreference {
  providerId: string
  modelId: string
  name?: string
  brandId?: string
}

[RendererAPI]
[Validator=TrustedRenderer]
[ContextBridge]
interface Campaigns {
  start(scenarioId: string) -> Campaign
  listForScenario(scenarioId: string) -> Campaign[]
  get(id: string) -> Campaign?
}

[RendererAPI]
[Validator=TrustedRenderer]
[ContextBridge]
interface CampaignPreferences {
  getDefaultModel() -> CampaignModelPreference?
  setDefaultModel(selection: ModelSelection) -> ModelSelection
}
