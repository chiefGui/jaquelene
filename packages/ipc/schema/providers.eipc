module jaquelene

zod_reference ProviderConfiguration {
  import = "@jaquelene/domain"
  type = "ProviderConfiguration"
  schema = "providerConfigurationSchema"
}

structure Provider {
  id: string
  name: string
  brandId: string
  configuration: ProviderConfiguration
}

zod_reference ProviderConfigureResult {
  import = "@jaquelene/domain"
  type = "ProviderConfigureResult"
  schema = "providerConfigureResultSchema"
}

[RendererAPI]
[Validator=TrustedRenderer]
[ContextBridge]
interface Providers {
  list() -> Provider[]
  configureApiKey(providerId: string, apiKey: string) -> ProviderConfigureResult
  clearConfiguration(providerId: string)
}
