module jaquelene

enum OpenRouterConfigurationState {
  Disconnected = "disconnected"
  Configured = "configured"
}

structure OpenRouterConfiguration {
  state: OpenRouterConfigurationState
  keyLabel?: string
}

enum OpenRouterConnectionState {
  Disconnected = "disconnected"
  Connected = "connected"
  Rejected = "rejected"
  Unavailable = "unavailable"
}

structure OpenRouterConnectionStatus {
  state: OpenRouterConnectionState
  keyLabel?: string
}

[RendererAPI]
[Validator=TrustedRenderer]
[ContextBridge]
interface OpenRouterConnection {
  getConfiguration() -> OpenRouterConfiguration
  connect(apiKey: string) -> OpenRouterConnectionStatus
  disconnect() -> OpenRouterConnectionStatus
}
