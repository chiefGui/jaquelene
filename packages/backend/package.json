{
  "name": "@jaquelene/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#backend/*": "./src/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./build": "./src/build.ts"
  },
  "scripts": {
    "bench:providers": "bun build ./src/provider/providers.benchmark.ts --target node --external effect --external drizzle-orm --external typeid-js --outfile ./node_modules/.cache/providers-benchmark.mjs && node ./node_modules/.cache/providers-benchmark.mjs",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts"
  },
  "dependencies": {
    "@jaquelene/domain": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-rc.112",
    "typeid-js": "^1.2.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@types/node": "^26.3.0",
    "drizzle-kit": "1.0.0-rc.4"
  }
}
