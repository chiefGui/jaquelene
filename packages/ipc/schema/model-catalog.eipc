module jaquelene

structure ModelReference {
  providerId: string
  modelId: string
}

structure ModelProvider {
  id: string
  brandId: string
}

structure ModelTokenPricing {
  inputUsdPerMillion: number
  outputUsdPerMillion: number
}

structure ModelReasoningCapability {
  required: boolean
}

structure AvailableModel {
  id: string
  name: string
  brandId: string
  reasoning?: ModelReasoningCapability
  tokenPricing?: ModelTokenPricing
}

structure ModelSelection {
  providerId: string
  modelId: string
  name: string
  brandId: string
}

subtype ModelCatalogRevision = number(
  minValue: 0
  maxValue: 9007199254740991
)

enum ModelCatalogFreshness {
  Fresh = "fresh"
  Stale = "stale"
}

enum ModelCatalogRefreshState {
  Idle = "idle"
  Refreshing = "refreshing"
  Failed = "failed"
}

enum ModelCatalogFailureKind {
  Source = "source"
  Timeout = "timeout"
}

structure ModelCatalogRefresh {
  state: ModelCatalogRefreshState
  startedAt?: number
  failedAt?: number
  retryAt?: number
  failureKind?: ModelCatalogFailureKind
}

structure ModelCatalogSnapshot {
  models: AvailableModel[]
  revision: ModelCatalogRevision
  freshness: ModelCatalogFreshness
  updatedAt: number
  discardAt: number
  refresh: ModelCatalogRefresh
}

[RendererAPI]
[Validator=TrustedRenderer]
[ContextBridge]
interface ModelCatalog {
  listProviders() -> ModelProvider[]
  getModels(providerId: string) -> ModelCatalogSnapshot
  refreshModels(providerId: string) -> ModelCatalogSnapshot

  [Event]
  ModelsChanged(providerId: string, revision: ModelCatalogRevision)
}
