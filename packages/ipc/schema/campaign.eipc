module jaquelene

structure CampaignGenerationPreferences {
  model?: ModelSelection
  reasoningPreset?: ReasoningPreset
}

structure Campaign {
  id: string
  title: CampaignTitle
  threadId: string
  startedAt: UnixTimeMilliseconds
  lastActivityAt: UnixTimeMilliseconds
  turnCount: ThreadTurnCount
  generationPreferences?: CampaignGenerationPreferences
}

structure CampaignSummary {
  id: string
  title: CampaignTitle
  threadId: string
  lastActivityAt: UnixTimeMilliseconds
}

subtype CampaignTitle = string(
  minLength: 1
  maxLength: 240
)

subtype CampaignPageCursor = string(
  minLength: 1
  maxLength: 512
)

structure CampaignSkillSelectionInput {
  kind: SkillKindKey
  skillKey?: SkillKey
}

structure StartCampaignRequest {
  title: CampaignTitle
  composition: CampaignSkillSelectionInput[]
}

structure CampaignPageRequest {
  cursor?: CampaignPageCursor
}

structure CampaignPage {
  campaigns: CampaignSummary[]
  nextCursor?: CampaignPageCursor
}

structure RenameCampaignRequest {
  id: string
  title: CampaignTitle
}

structure CampaignDeletion {
  id: string
  threadId: string
}

structure CampaignUsageAttempts {
  provider: UsageCount
  preparing: UsageCount
  pending: UsageCount
  completed: UsageCount
  failed: UsageCount
}

structure CampaignModelUsage {
  providerId: string
  requestedModelId: string
  resolvedModelId?: string
  upstreamProviderId?: string
  attempts: UsageCount
}

structure CampaignUsageSnapshot {
  campaignId: string
  attempts: CampaignUsageAttempts
  tokenCoverage: UsageCoverage
  tokens?: UsageTokens
  costCoverage: UsageCoverage
  costs: UsageCost[]
  models: CampaignModelUsage[]
}

[RendererAPI]
[Validator=TrustedRenderer]
[ContextBridge]
interface Campaigns {
  start(request: StartCampaignRequest) -> Campaign
  list(request: CampaignPageRequest) -> CampaignPage
  get(id: string) -> Campaign?
  delete(id: string) -> CampaignDeletion?
  rename(request: RenameCampaignRequest) -> Campaign?
  setGenerationPreferences(id: string, preferences: CampaignGenerationPreferences?) -> Campaign?
}

[RendererAPI]
[Validator=TrustedRenderer]
[ContextBridge]
interface CampaignUsage {
  get(id: string) -> CampaignUsageSnapshot?
}

[RendererAPI]
[Validator=TrustedRenderer]
[ContextBridge]
interface CampaignPreferences {
  getDefaultModel() -> ModelSelection?
  setDefaultModel(selection: ModelSelection) -> ModelSelection
}

enum CampaignSkillSource {
  Campaign = "campaign"
  Default = "default"
  Fallback = "fallback"
  None = "none"
}

structure CampaignSkillSelection {
  campaignId: string
  kind: SkillKindKey
  selectedSkillKey?: SkillKey
  effectiveSkillKey?: SkillKey
  source: CampaignSkillSource
}

structure GetCampaignSkillSelectionRequest {
  campaignId: string
  kind: SkillKindKey
}

structure SetCampaignSkillSelectionRequest {
  campaignId: string
  kind: SkillKindKey
  skillKey?: SkillKey
}

[RendererAPI]
[Validator=TrustedRenderer]
[ContextBridge]
interface CampaignSkills {
  getSelection(request: GetCampaignSkillSelectionRequest) -> CampaignSkillSelection?
  setSelection(request: SetCampaignSkillSelectionRequest) -> CampaignSkillSelection?
}
