module jaquelene

structure ModelReference {
  providerId: string
  modelId: string
}

structure ModelProvider {
  id: string
  brandId: string
}

structure AvailableModel {
  id: string
  name: string
  brandId: string
}

structure ModelSelection {
  providerId: string
  modelId: string
  name: string
  brandId: string
}

[RendererAPI]
[Validator=TrustedRenderer]
[ContextBridge]
interface ModelCatalog {
  listProviders() -> ModelProvider[]
  listModels(providerId: string) -> AvailableModel[]
}
