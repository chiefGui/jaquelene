module jaquelene

enum UiTheme {
  Jaquelene = "jaquelene"
  Dracula = "dracula"
}

enum UiFont {
  System = "system"
  Inter = "inter"
  Geist = "geist"
}

enum InterfaceScale {
  Percent90 = "90"
  Percent100 = "100"
  Percent110 = "110"
  Percent125 = "125"
}

enum MotionPreference {
  System = "system"
  Reduced = "reduced"
  Full = "full"
}

structure UserInterfacePreferenceValues {
  theme: UiTheme
  font: UiFont
  scale: InterfaceScale
  motion: MotionPreference
}

[RendererAPI]
[Validator=TrustedRenderer]
[ContextBridge]
interface UserInterfacePreferences {
  get() -> UserInterfacePreferenceValues
  setTheme(theme: UiTheme) -> UserInterfacePreferenceValues
  setFont(font: UiFont) -> UserInterfacePreferenceValues
  setScale(scale: InterfaceScale) -> UserInterfacePreferenceValues
  setMotion(motion: MotionPreference) -> UserInterfacePreferenceValues
}
