    {
      "value": "\"context_sequence\" > 0",
      "name": "generations_context_sequence_positive",
      "entityType": "checks",
      "table": "generations"
    },
    {
      "value": "length(trim(\"provider_id\")) > 0 AND length(trim(\"model_id\")) > 0",
      "name": "generations_model_reference_valid",
      "entityType": "checks",
      "table": "generations"
    },
    {
      "value": "\"status\" IN ('pending', 'completed', 'failed')",
      "name": "generations_status_valid",
      "entityType": "checks",
      "table": "generations"
    },
    {
      "value": "\"failure_kind\" IS NULL OR \"failure_kind\" IN ('provider', 'invalid-output', 'superseded', 'interrupted', 'storage')",
      "name": "generations_failure_kind_valid",
      "entityType": "checks",
      "table": "generations"
    },
    {
      "value": "(\"provider_generation_id\" IS NULL OR length(trim(\"provider_generation_id\")) > 0)\n        AND (\"resolved_model_id\" IS NULL OR length(trim(\"resolved_model_id\")) > 0)\n        AND (\"finish_reason\" IS NULL OR length(trim(\"finish_reason\")) > 0)",
      "name": "generations_provider_result_valid",
      "entityType": "checks",
      "table": "generations"
    },
    {
      "value": "(\"input_tokens\" IS NULL AND \"output_tokens\" IS NULL AND \"total_tokens\" IS NULL)\n        OR (\"input_tokens\" IS NOT NULL\n          AND \"output_tokens\" IS NOT NULL\n          AND \"total_tokens\" IS NOT NULL\n          AND \"input_tokens\" >= 0\n          AND \"output_tokens\" >= 0\n          AND \"total_tokens\" >= 0)",
      "name": "generations_usage_valid",
      "entityType": "checks",
      "table": "generations"
    },
    {
      "value": "\"started_at\" >= 0",
      "name": "generations_started_at_nonnegative",
      "entityType": "checks",
      "table": "generations"
    },
    {
      "value": "\"finished_at\" IS NULL OR \"finished_at\" >= \"started_at\"",
      "name": "generations_finished_at_valid",
      "entityType": "checks",
      "table": "generations"
    },
    {
      "value": "(\"status\" = 'pending'\n          AND \"finished_at\" IS NULL\n          AND \"failure_kind\" IS NULL\n          AND \"output_message_id\" IS NULL)\n        OR (\"status\" = 'completed'\n          AND \"finished_at\" IS NOT NULL\n          AND \"failure_kind\" IS NULL\n          AND \"output_message_id\" IS NOT NULL)\n        OR (\"status\" = 'failed'\n          AND \"finished_at\" IS NOT NULL\n          AND \"failure_kind\" IS NOT NULL\n          AND \"output_message_id\" IS NULL)",
      "name": "generations_state_valid",
      "entityType": "checks",
      "table": "generations"
    },
    {
      "value": "\"sequence\" > 0",
      "name": "thread_messages_sequence_positive",
      "entityType": "checks",
      "table": "thread_messages"
    },
    {
      "value": "\"author\" IN ('user', 'assistant')",
      "name": "thread_messages_author_valid",
      "entityType": "checks",
      "table": "thread_messages"
    },
    {
      "value": "length(trim(\"content\")) > 0 AND length(\"content\") <= 100000",
      "name": "thread_messages_content_valid",
      "entityType": "checks",
      "table": "thread_messages"
    },
    {
      "value": "\"created_at\" >= 0",
      "name": "thread_messages_created_at_nonnegative",
      "entityType": "checks",
      "table": "thread_messages"
    },
    {
      "value": "\"created_at\" >= 0",
      "name": "threads_created_at_nonnegative",
      "entityType": "checks",
      "table": "threads"
    },
    {
      "value": "\"last_message_sequence\" >= 0",
      "name": "threads_last_message_sequence_nonnegative",
      "entityType": "checks",
      "table": "threads"
    }
