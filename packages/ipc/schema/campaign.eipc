module jaquelene

structure Campaign {
  id: string
  scenarioId: string
  threadId: string
  startedAt: UnixTimeMilliseconds
  generationConfigurationOverride?: GenerationConfigurationSelection
}

[RendererAPI]
[Validator=TrustedRenderer]
[ContextBridge]
interface Campaigns {
  start(scenarioId: string) -> Campaign
  listForScenario(scenarioId: string) -> Campaign[]
  get(id: string) -> Campaign?
  setGenerationConfigurationOverride(id: string, configuration: GenerationConfigurationSelection?) -> Campaign?
}

[RendererAPI]
[Validator=TrustedRenderer]
[ContextBridge]
interface CampaignPreferences {
  getDefaultModel() -> ModelSelection?
  setDefaultModel(selection: ModelSelection) -> ModelSelection
}
