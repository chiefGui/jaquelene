module jaquelene

structure Campaign {
  id: string
  scenarioId: string
  threadId: string
  startedAt: UnixTimeMilliseconds
  modelOverride?: ModelSelection
}

structure CampaignContinuation {
  campaignId: string
  scenarioId: string
  scenarioTitle: string
}

[RendererAPI]
[Validator=TrustedRenderer]
[ContextBridge]
interface Campaigns {
  start(scenarioId: string) -> Campaign
  listForScenario(scenarioId: string) -> Campaign[]
  get(id: string) -> Campaign?
  getContinuation() -> CampaignContinuation?
  setModelOverride(id: string, model: ModelSelection?) -> Campaign?
}

[RendererAPI]
[Validator=TrustedRenderer]
[ContextBridge]
interface CampaignPreferences {
  getDefaultModel() -> ModelSelection?
  setDefaultModel(selection: ModelSelection) -> ModelSelection
}
