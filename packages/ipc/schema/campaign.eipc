module jaquelene

structure CampaignGenerationPreferences {
  model?: ModelSelection
  reasoningPreset?: ReasoningPreset
}

structure Campaign {
  id: string
  scenarioId: string
  threadId: string
  startedAt: UnixTimeMilliseconds
  generationPreferences?: CampaignGenerationPreferences
}

subtype CampaignUsageCount = number(
  minValue: 0
  maxValue: 9007199254740991
)

enum CampaignCostSource {
  ProviderReported = "provider-reported"
  Estimated = "estimated"
}

structure CampaignUsageAttempts {
  provider: CampaignUsageCount
  preparing: CampaignUsageCount
  pending: CampaignUsageCount
  completed: CampaignUsageCount
  failed: CampaignUsageCount
}

structure CampaignUsageCoverage {
  reported: CampaignUsageCount
  unknown: CampaignUsageCount
}

structure CampaignTokenUsage {
  input: CampaignUsageCount
  output: CampaignUsageCount
  total: CampaignUsageCount
  cacheReadInput?: CampaignUsageCount
  cacheWriteInput?: CampaignUsageCount
  reasoningOutput?: CampaignUsageCount
}

structure CampaignCostUsage {
  currency: string
  source: CampaignCostSource
  amountNanos: CampaignUsageCount
  attempts: CampaignUsageCount
}

structure CampaignModelUsage {
  providerId: string
  requestedModelId: string
  resolvedModelId?: string
  upstreamProviderId?: string
  attempts: CampaignUsageCount
}

structure CampaignUsageSnapshot {
  campaignId: string
  attempts: CampaignUsageAttempts
  tokenCoverage: CampaignUsageCoverage
  tokens?: CampaignTokenUsage
  costCoverage: CampaignUsageCoverage
  costs: CampaignCostUsage[]
  models: CampaignModelUsage[]
}

[RendererAPI]
[Validator=TrustedRenderer]
[ContextBridge]
interface Campaigns {
  start(scenarioId: string) -> Campaign
  listForScenario(scenarioId: string) -> Campaign[]
  get(id: string) -> Campaign?
  setGenerationPreferences(id: string, preferences: CampaignGenerationPreferences?) -> Campaign?
}

[RendererAPI]
[Validator=TrustedRenderer]
[ContextBridge]
interface CampaignUsage {
  get(id: string) -> CampaignUsageSnapshot?
}

[RendererAPI]
[Validator=TrustedRenderer]
[ContextBridge]
interface CampaignPreferences {
  getDefaultModel() -> ModelSelection?
  setDefaultModel(selection: ModelSelection) -> ModelSelection
}
