module jaquelene

zod_reference SkillId {
  import = "@jaquelene/domain"
  type = "SkillId"
  schema = "skillIdSchema"
}

zod_reference SkillDescriptor {
  import = "@jaquelene/domain"
  type = "SkillDescriptor"
  schema = "skillDescriptorSchema"
}

zod_reference PlayerResponseResult {
  import = "@jaquelene/ipc/player-response"
  type = "PlayerResponseResult"
  schema = "playerResponseResultSchema"
}

subtype PlayerResponseRequestId = string(minLength: 1 maxLength: 64)

structure ExecutePlayerResponseRequest {
  requestId: PlayerResponseRequestId
  skillId: SkillId
  threadId: string
  configuration: RequestedModelConfiguration
}

[RendererAPI]
[Validator=TrustedRenderer]
[ContextBridge]
interface PlayerResponses {
  list() -> SkillDescriptor[]
  execute(request: ExecutePlayerResponseRequest) -> PlayerResponseResult
  cancel(requestId: PlayerResponseRequestId) -> boolean
}
