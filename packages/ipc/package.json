{
  "name": "@jaquelene/ipc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./main": {
      "types": "./dist/types/browser/jaquelene.d.ts",
      "development": "./dist/development/browser/jaquelene.js",
      "default": "./dist/production/browser/jaquelene.js"
    },
    "./preload": {
      "types": "./dist/types/preload/jaquelene.d.ts",
      "development": "./dist/development/preload/jaquelene.js",
      "default": "./dist/production/preload/jaquelene.js"
    },
    "./renderer": {
      "types": "./dist/types/renderer/jaquelene.d.ts",
      "jaquelene-test": "./dist/production/renderer/jaquelene.js",
      "development": "./dist/development/renderer/jaquelene.js",
      "default": "./dist/production/renderer/jaquelene.js"
    }
  },
  "scripts": {
    "build": "generate-ipc schema generated/production && tsc -b",
    "build:development": "generate-ipc schema generated/development && tsc -b tsconfig.development.json"
  },
  "dependencies": {
    "@jaquelene/domain": "workspace:*"
  },
  "devDependencies": {
    "@marshallofsound/ipc": "^2.7.1",
    "@types/node": "^26.3.0",
    "electron": "^44.0.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "electron": ">=44.0.0"
  }
}
