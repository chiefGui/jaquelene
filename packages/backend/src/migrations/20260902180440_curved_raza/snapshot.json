      "entityType": "checks",
      "table": "generations"
    },
    {
      "value": "(\"reasoning_preset\" IS NULL AND \"reasoning_preset_source\" IS NULL)\n        OR (\"reasoning_preset\" IS NOT NULL\n          AND \"reasoning_preset_source\" IS NOT NULL\n          AND \"reasoning_preset\" IN ('automatic', 'on', 'off', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max')\n          AND \"reasoning_preset_source\" IN ('model-default', 'selection'))",
      "name": "generations_reasoning_valid",
      "entityType": "checks",
      "table": "generations"
    },
    {
      "value": "\"status\" IN ('pending', 'completed', 'failed')",
      "name": "generations_status_valid",
